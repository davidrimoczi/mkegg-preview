---
// Renders the article text and places roster cards in it:
// at each "[roster]" line, in order, or else after the second paragraph.
import { getImage } from 'astro:assets';
import { rosterHtml, type RosterCard } from '../lib/roster';
import { mediaMeta } from '../lib/media';
interface Props { rosters: RosterCard[] }
let html = await Astro.slots.render('default');
const cards: string[] = [];
for (const c of Astro.props.rosters) {
  const meta = await mediaMeta(c.logo ?? undefined);
  const logo = meta ? (await getImage({ src: meta, width: Math.min(96, meta.width), format: 'webp' })).src : undefined;
  const photos: (string | undefined)[] = [];
  for (const p of c.players) {
    const pm = await mediaMeta(p.photo ?? undefined);
    photos.push(pm ? (await getImage({ src: pm, width: Math.min(320, pm.width), format: 'webp', quality: 80 })).src : undefined);
  }
  cards.push(rosterHtml(c, logo, photos));
}
const marker = /<p>\s*\\?\[roster\\?\]\s*<\/p>/i;
const rest: string[] = [];
for (const c of cards) {
  if (marker.test(html)) html = html.replace(marker, c);
  else rest.push(c);
}
html = html.replace(new RegExp(marker.source, 'gi'), '');
if (rest.length) {
  let n = 0;
  const at = html.replace(/<\/p>/g, (m) => (++n === 2 ? m + '\u0000' : m));
  html = at.includes('\u0000') ? at.replace('\u0000', rest.join('')) : html + rest.join('');
}
---
<div class="prose" set:html={html} />
