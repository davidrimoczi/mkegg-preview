---
import Base from '../layouts/Base.astro';
import StoryLabel from '../components/StoryLabel.astro';
import Picture from '../components/Picture.astro';
import { articles, articleUrl, url, ago, fmtDate } from '../lib/site';

const all = await articles();
const lead = all.find((a) => a.data.featured) ?? all[0];
const rest = all.filter((a) => a !== lead);
const latest = rest.slice(0, 4);
const news = rest.filter((a) => a.data.kind === 'News').slice(0, 4);
const interviews = rest.filter((a) => a.data.kind === 'Interview').slice(0, 4);
// Every article ticked "Featured" stays here after a newer one takes the lead.
const featured = all.filter((a) => a.data.featured);
const nowLeading = featured[0] === lead ? lead : undefined;
const pastFeatured = featured.filter((a) => a !== nowLeading).slice(0, 4);
const group = (k: string) => (k === 'News' ? 'news' : k === 'Interview' ? 'interviews' : 'features');
---
<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'NewsMediaOrganization', '@id': new URL(url('/#org'), Astro.site).href, name: 'M/KE', url: new URL(url('/'), Astro.site).href,
        logo: { '@type': 'ImageObject', url: new URL(url('/brand/og-default.png'), Astro.site).href },
        email: 'contact@mkegg.com', sameAs: ['https://x.com/mkeggcom'],
        publishingPrinciples: new URL(url('/standards/'), Astro.site).href },
      { '@type': 'WebSite', name: 'M/KE', url: new URL(url('/'), Astro.site).href, publisher: { '@id': new URL(url('/#org'), Astro.site).href } },
    ],
  })} />
  <div class="wrap">
    <section class="home-grid">
      {lead ? (
        <article class="lead">
          <a href={articleUrl(lead)}><Picture src={lead.data.image} alt={lead.data.imageAlt} note="Lead photo" eager /></a>
          <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
            <StoryLabel label={lead.data.label} />
            <span class="meta">{lead.data.league} · {lead.data.kind}{lead.data.readTime ? ` · ${lead.data.readTime} min read` : ''}</span>
          </div>
          <h1><a href={articleUrl(lead)}>{lead.data.title}</a></h1>
          <p class="standfirst">{lead.data.standfirst}</p>
        </article>
      ) : (
        <div class="lead">
          <span class="eyebrow">Independent esports media</span>
          <h1>Beyond the <em>game.</em></h1>
          <p class="standfirst">News. Interviews. Stories. The first M/KE pieces land on 4 January 2027.</p>
        </div>
      )}
      <aside class="latest" aria-labelledby="latest-h">
        <h2 id="latest-h" class="eyebrow">Latest</h2>
        {latest.length ? latest.map((a) => (
          <a href={articleUrl(a)}>
            <span class="t">{a.data.title}</span>
            <span class="when"><StoryLabel label={a.data.label ?? (a.data.kind === 'Opinion' ? 'Opinion' : undefined)} /> {a.data.kind} · {ago(a.data.date)}</span>
          </a>
        )) : <p class="when">More stories soon.</p>}
      </aside>
    </section>

    {news.length > 0 && (
      <section class="section pop" aria-labelledby="news-h">
        <div class="section-head">
          <div><h2 id="news-h">News</h2><p class="sec-intro">The latest from the LEC and beyond, as it happens.</p></div>
          <a class="see-all" href={url('/news/')}>All news<svg class="arr" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 6h16M11 1l5 5-5 5"/></svg></a>
        </div>
        <div class="compact">
          {news.map((a) => (
            <a href={articleUrl(a)}>
              <Picture src={a.data.image} alt="" ratio="3 / 2" sizes="(max-width: 600px) 100vw, 300px" />
              <span><span class="meta">{a.data.league}</span><span class="t">{a.data.title}</span><span class="d">{a.data.standfirst}</span><span class="when">{ago(a.data.date)}</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    {interviews.length > 0 && (
      <section class="section pop" aria-labelledby="int-h">
        <div class="section-head">
          <div><h2 id="int-h">Interviews</h2><p class="sec-intro">Players, coaches and creators, in their own words.</p></div>
          <a class="see-all" href={url('/interviews/')}>All interviews<svg class="arr" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 6h16M11 1l5 5-5 5"/></svg></a>
        </div>
        <div class="cards cards-4">
          {interviews.map((a) => (
            <a class="card" href={articleUrl(a)}>
              <Picture src={a.data.image} alt={a.data.imageAlt} note="Portrait" ratio="4 / 5" sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 300px" />
              <span class="meta gold">Interview · {a.data.league}</span>
              <span class="t">{a.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {featured.length > 0 && (
      <section class="section pop" aria-labelledby="feat-h">
        <div class="section-head">
          <div><h2 id="feat-h">Featured</h2><p class="sec-intro">Our biggest stories: every piece that has led the front page.</p></div>
          <a class="see-all" href={url('/featured/')}>All featured<svg class="arr" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 6h16M11 1l5 5-5 5"/></svg></a>
        </div>
        <div class="feat-grid">
          {nowLeading && (
            <a class="feat-now" href={articleUrl(nowLeading)}>
              <Picture src={nowLeading.data.image} alt={nowLeading.data.imageAlt} ratio="4 / 3" sizes="(max-width: 900px) 100vw, 480px" />
              <span class="feat-copy">
                <span class="meta gold">{nowLeading.data.kind} · Now leading</span>
                <span class="t">{nowLeading.data.title}</span>
                <span class="d">{nowLeading.data.standfirst}</span>
              </span>
            </a>
          )}
          {pastFeatured.map((a) => (
            <a class="card" href={articleUrl(a)}>
              <Picture src={a.data.image} alt={a.data.imageAlt} ratio="3 / 2" sizes="(max-width: 900px) 100vw, 400px" />
              <span class="meta">{a.data.kind} · {ago(a.data.date)}</span>
              <span class="t">{a.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {all.length > 0 && (
      <section class="section" aria-labelledby="all-h" data-explore>
        <div class="section-head">
          <div><h2 id="all-h">Explore all articles</h2><p class="sec-intro">Everything we've published, newest first.</p></div>
          <div class="filters" role="group" aria-label="Show">
            <button type="button" data-f="all" aria-pressed="true">All</button>
            <button type="button" data-f="news" aria-pressed="false">News</button>
            <button type="button" data-f="interviews" aria-pressed="false">Interviews</button>
            <button type="button" data-f="features" aria-pressed="false">Features</button>
          </div>
        </div>
        <div class="rows">
          {all.map((a) => (
            <a class="row" href={articleUrl(a)} data-g={group(a.data.kind)}>
              <Picture src={a.data.image} alt="" ratio="3 / 2" sizes="(max-width: 600px) 100vw, 220px" />
              <span class="row-copy">
                <span class="meta">{a.data.league} · {a.data.kind}</span>
                <span class="t">{a.data.title}</span>
                <span class="d">{a.data.standfirst}</span>
              </span>
              <span class="when">{fmtDate(a.data.date)}</span>
            </a>
          ))}
        </div>
        <p class="empty when" hidden>Nothing in this category yet.</p>
        <div class="more-wrap"><button type="button" class="btn btn-ghost" data-more hidden>Load more articles</button></div>
      </section>
    )}

    <section class="newsletter" aria-labelledby="nl-h">
      <div class="copy">
        <span class="eyebrow">The M/KE Brief</span>
        <h2 id="nl-h">The week in esports, in five minutes.</h2>
        <p>Our newsletter is coming soon. Until then, follow us on X for every story as it lands.</p>
      </div>
      <a class="btn btn-primary" href="https://x.com/mkeggcom" rel="noopener">Follow @mkeggcom</a>
    </section>
  </div>
  <script>
    // Explore all: show 10 at a time, filter by kind. Without JavaScript every article is listed.
    const box = document.querySelector<HTMLElement>('[data-explore]');
    if (box) {
      const rows = [...box.querySelectorAll<HTMLElement>('.row')];
      const more = box.querySelector<HTMLButtonElement>('[data-more]')!;
      const empty = box.querySelector<HTMLElement>('.empty')!;
      const STEP = 10;
      let f = 'all', shown = STEP;
      const draw = () => {
        const match = rows.filter((r) => f === 'all' || r.dataset.g === f);
        rows.forEach((r) => (r.hidden = true));
        match.slice(0, shown).forEach((r) => (r.hidden = false));
        more.hidden = match.length <= shown;
        empty.hidden = match.length > 0;
      };
      box.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.addEventListener('click', () => {
        f = b.dataset.f!; shown = STEP;
        box.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        draw();
      }));
      more.addEventListener('click', () => { shown += STEP; draw(); });
      draw();
    }
  </script>
</Base>
