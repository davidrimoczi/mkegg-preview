---
// One hub page per competition: /lec/, /lck/, /lpl/, /lcs/, /first-stand/, /msi/, /worlds/
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { LEAGUES, type League } from '../../data/leagues';
import { articles, articleUrl, url, ago } from '../../lib/site';

export function getStaticPaths() {
  return LEAGUES.map((league) => ({ params: { league: league.slug }, props: { league } }));
}
const { league } = Astro.props as { league: League };
const stories = (await articles()).filter((a) => a.data.league === league.name);
const isInternational = league.badge === 'INT';
---
<Base title={league.name} description={`${league.full}: news, interviews, schedule and standings from M/KE.`}>
  <div class="wrap">
    <section class="hub-hero">
      <div style="display:flex;flex-direction:column;gap:22px">
        <span class="eyebrow">{league.full} · {league.status}</span>
        <h1>{league.name} <em>2027.</em></h1>
        <div class="tick-cd hub-cd" data-countdown={league.start?.toISOString()} data-done={`${league.name} is live`}>
          <span data-cd-label>Starts in</span>
          <span class="mini" aria-hidden="true"><b data-u="d">00</b>d</span><span class="mini" aria-hidden="true"><b data-u="h">00</b>h</span><span class="mini" aria-hidden="true"><b data-u="m">00</b>m</span>
          {!league.start && <span class="tba">Date TBA</span>}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:20px">
        <div class="panel">
          <h2>Upcoming games</h2>
          {league.schedule.length ? league.schedule.map((m) => (
            <div class="row"><span class="d">{m.day}</span><span>{m.a}</span><span class="vs">vs</span><span>{m.b}</span><span class="r">{m.time}</span></div>
          )) : <p class="note">The schedule goes up here as soon as Riot publishes it. All times CET.</p>}
        </div>
        <div class="panel">
          <h2>{isInternational ? 'Results' : 'Standings'}</h2>
          {league.standings.length ? (
            <table class="standings">
              <thead><tr><th scope="col">#</th><th scope="col">Team</th><th scope="col">W–L</th></tr></thead>
              <tbody>{league.standings.map((s, i) => <tr><td>{i + 1}</td><td>{s.team}</td><td>{s.w}–{s.l}</td></tr>)}</tbody>
            </table>
          ) : <p class="note">{isInternational ? 'Results appear here once the event starts.' : 'Standings appear here once the season starts.'}</p>}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="hub-news">
      <div class="section-head"><h2 id="hub-news">{league.name} news</h2>{stories.length > 0 && <a class="see-all" href={url(`/${league.slug}/articles/`)}>All {league.name} articles<svg class="arr" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 6h16M11 1l5 5-5 5"/></svg></a>}</div>
      {stories.length ? (
        <div class="cards cards-4">
          {stories.slice(0, 8).map((a) => (
            <a class="card" href={articleUrl(a)}>
              <Picture src={a.data.image} alt={a.data.imageAlt} ratio="3 / 2" sizes="(max-width: 900px) 100vw, 400px" />
              <span class="meta" style="color:var(--accent-text)">{a.data.label ?? a.data.kind}</span>
              <span class="t" style="font-size:20px">{a.data.title}</span>
              <span class="when">{ago(a.data.date)}</span>
            </a>
          ))}
        </div>
      ) : <p class="note">{league.name} coverage starts soon.</p>}
    </section>
  </div>
</Base>
