---
import Base from '../../layouts/Base.astro';
import StoryLabel from '../../components/StoryLabel.astro';
import Picture from '../../components/Picture.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { render } from 'astro:content';
import { articles, articleUrl, url, fmtDate, tagUrl, type Article } from '../../lib/site';
import { leagueByName } from '../../data/leagues';
import { authorByName } from '../../data/authors';
import { socialImage, mediaMeta } from '../../lib/media';

export async function getStaticPaths() {
  const all = await articles();
  return all.map((a) => ({ params: { id: a.id }, props: { article: a, all } }));
}
const { article, all } = Astro.props as { article: Article; all: Article[] };
const { Content } = await render(article);
const d = article.data;
const next = all.filter((a) => a.id !== article.id).slice(0, 3);
const hub = leagueByName(d.league);
const author = authorByName(d.author);
const authorUrl = author ? url(`/authors/${author.slug}/`) : undefined;
const authorName = author?.name ?? d.author;
const og = await socialImage(d.image);
const meta = await mediaMeta(d.image);
const abs = (p: string) => new URL(p, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': d.kind === 'Opinion' ? 'OpinionNewsArticle' : d.kind === 'Analysis' ? 'AnalysisNewsArticle' : 'NewsArticle',
  headline: d.title,
  description: d.standfirst,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  mainEntityOfPage: abs(articleUrl(article)),
  image: og ? [abs(og)] : [abs(url('/brand/og-default.png'))],
  author: [{ '@type': 'Person', name: authorName, ...(authorUrl ? { url: abs(authorUrl) } : {}) }],
  publisher: { '@type': 'NewsMediaOrganization', name: 'M/KE', url: abs(url('/')), logo: { '@type': 'ImageObject', url: abs(url('/brand/og-default.png')) } },
  articleSection: d.league,
  ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
  isAccessibleForFree: true,
};
const section = { News: 'news', Feature: 'features', Interview: 'interviews', Analysis: 'analysis', Opinion: 'analysis' }[d.kind];
---
<Base title={d.title} description={d.standfirst} image={og} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta property="article:published_time" content={d.date.toISOString()} />
    <meta property="article:modified_time" content={(d.updated ?? d.date).toISOString()} />
    <meta property="article:section" content={d.league} />
  </Fragment>
  <div class="article-main" data-reading>
    <article class="article">
      <header class="art-hero">
        <Picture class="art-hero-img" src={d.image} alt={d.imageAlt} note="Lead photo" ratio="auto" sizes="(max-width: 1100px) 100vw, 1040px" eager />
        <span class="art-hero-fade" aria-hidden="true"></span>
        {d.imageCredit && <p class="art-hero-credit">Photo: {d.imageCredit}</p>}
        <div class="art-hero-text">
          <div class="crumbs">
            <a href={url(hub ? `/${hub.slug}/` : '/')}>{d.league}</a><span aria-hidden="true">/</span><a href={url(`/${section}/`)}>{d.kind}</a>
          </div>
          <h1>{d.title}</h1>
          <p class="standfirst">{d.standfirst}</p>
        </div>
      </header>
      <div class="article-bar">
        <div class="who">
          <b>By {authorUrl ? <a href={authorUrl} rel="author">{authorName}</a> : authorName}</b>
          <span class="when"><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>{d.readTime ? ` · ${d.readTime} min read` : ''}</span>
          {d.updated && <span class="when">Updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></span>}
        </div>
        {d.tags.length > 0 && (
          <nav class="tags tags-inline" aria-label="Tags">
            {d.tags.map((t) => <a class="tag" href={tagUrl(t)} rel="tag">{t}</a>)}
          </nav>
        )}
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <StoryLabel label={d.label} />
          <button class="lamp" type="button" data-lamp aria-pressed="false">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle class="glow" cx="12" cy="9" r="9" /><path class="bulb" d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z" stroke-width="1.6" stroke-linejoin="round" /></svg>
            <span class="on-label">Reading light</span><span class="off-label">Light off</span>
          </button>
        </div>
      </div>
      <ArticleBody rosters={d.rosters}><Content /></ArticleBody>

    </article>
    {next.length > 0 && (
      <section class="more" aria-labelledby="next-h">
        <h2 id="next-h" class="eyebrow" style="color:var(--ink)">Read next</h2>
        <div class="cards" style="margin-top:24px">
          {next.map((a) => (
            <a class="next-card" href={articleUrl(a)}>
              <Picture class="next-img" src={a.data.image} alt="" note="" ratio="4 / 3" sizes="140px" />
              <span class="next-text">
                <span class="meta" style="color:var(--accent-text)">{a.data.kind}</span>
                <span class="t">{a.data.title}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
  <script is:inline>
    (function () {
      // On articles the bulb is the site's light switch: on = light mode (Bone), off = dark.
      // It and the header's sun/moon button always agree, and the choice carries across the site.
      var btn = document.querySelector('[data-lamp]');
      var root = document.documentElement;
      var paint = function () { btn.setAttribute('aria-pressed', root.dataset.theme === 'light' ? 'true' : 'false'); };
      paint();
      btn.addEventListener('click', function () {
        var next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.classList.add('fading');
        root.dataset.theme = next;
        try { localStorage.setItem('mke-theme', next); } catch (e) {}
        setTimeout(function () { root.classList.remove('fading'); }, 800);
      });
      new MutationObserver(paint).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    })();
  </script>
</Base>
