---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import { url, IS_PREVIEW } from '../lib/site';

interface Props { title?: string; description?: string; image?: string; active?: string; ticker?: boolean }
const {
  title,
  description = 'News. Interviews. Stories. Independent esports media, beyond the game.',
  image = '/brand/og-default.png',
  active = '',
  ticker = true,
} = Astro.props;
const fullTitle = title ? `${title} · M/KE` : 'M/KE · Beyond the game.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const nav = [
  { href: '/lec/', label: 'LEC', key: 'lec' },
  { href: '/news/', label: 'News', key: 'news' },
  { href: '/interviews/', label: 'Interviews', key: 'interviews' },
  { href: '/features/', label: 'Features', key: 'features' },
  { href: '/analysis/', label: 'Analysis', key: 'analysis' },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {IS_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0b0b0b" />
  <link rel="icon" href={url('/favicon.ico')} sizes="any" />
  <link rel="icon" type="image/png" href={url('/favicon.png')} />
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
  <meta property="og:site_name" content="M/KE" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@mkeggcom" />
  <script is:inline>
    // Apply the reader's saved theme before the page paints (dark is the default).
    try { var t = localStorage.getItem('mke-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={url('/')} aria-label="M/KE home"><Wordmark height={34} /></a>
      <nav class="nav" aria-label="Sections">
        {nav.map((n) => <a href={url(n.href)} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="header-tools">
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch light or dark mode">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn btn-primary btn-sm" href="https://x.com/mkeggcom" rel="noopener">Follow on X</a>
      </div>
    </div>
  </header>
  {ticker && (
    <div class="ticker">
      <div class="wrap">
        <a class="hot" href={url('/lec/')}>LEC Winter starts 15 January</a><i>/</i>
        <a href={url('/interviews/')}>Interviews</a><i>/</i>
        <a href={url('/standards/')}>How we report</a>
      </div>
    </div>
  )}
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <a class="logo" href={url('/')} aria-label="M/KE home"><Wordmark height={26} /></a>
      <nav aria-label="Footer">
        <a href={url('/about/')}>About</a>
        <a href={url('/standards/')}>Editorial standards</a>
        <a href="https://x.com/mkeggcom" rel="noopener">X</a>
        <a href="mailto:contact@mkegg.com">contact@mkegg.com</a>
      </nav>
      <span>© {new Date().getFullYear()} M/KE. All rights reserved.</span>
    </div>
  </footer>
  {IS_PREVIEW && <div class="preview-flag">Preview · not live</div>}
  <script is:inline>
    document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
      b.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('mke-theme', next); } catch (e) {}
      });
    });
  </script>
</body>
</html>
